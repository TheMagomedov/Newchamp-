"Equipment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#243b53"><FONT COLOR="white"><B>Equipment</B><BR/>Оборудование</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579">PK </FONT></TD><TD ALIGN="LEFT">Id</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579"> </FONT></TD><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">nvarchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579">FK </FONT></TD><TD ALIGN="LEFT">WorkshopId</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579">FK </FONT></TD><TD ALIGN="LEFT">EquipmentTypeId ?</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579"> </FONT></TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">nvarchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579">FK </FONT></TD><TD ALIGN="LEFT">CreatedBy ?</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#546579">FK </FONT></TD><TD ALIGN="LEFT">UpdatedBy ?</TD><TD ALIGN="LEFT"><FONT COLOR="#65758b">int</FONT></TD></TR></TABLE>>];

digraph ER {
graph [rankdir=LR, bgcolor="#f5f8fc", pad="0.45", nodesep="0.48", ranksep="1.15", splines=polyline, fontname="Arial", fontsize=24, labelloc=t, label="ТОиР-Проф · основные связи для заучивания\nКлючи и основные поля · PK — первичный ключ · FK — внешний ключ · ? — NULL" ];
node [shape=plain, fontname="Arial"];
